{
  "name": "backtest-dashboard-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3230",
    "build": "next build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "data:generate": "node scripts/generate-data.mjs",
    "data:check": "node scripts/check-data.mjs",
    "artifact:check": "node scripts/check-artifact.mjs",
    "browser:check": "node scripts/browser-check.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir tmp/wrangler-dry-run",
    "public:check": "node scripts/public-audit.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^1.52.0",
    "shadcn": "^4.21.3",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.1",
    "playwright-core": "^1.63.0",
    "@axe-core/playwright": "^4.11.1",
    "wrangler": "4.148.0"
  }
}
